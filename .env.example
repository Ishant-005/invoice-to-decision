# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key. Used only by the backend, only in the Extract stage.
ANTHROPIC_API_KEY=

# Model used to read the invoice PDF.
EXTRACTION_MODEL=claude-sonnet-5-5

# fallback = always call the live API; if it fails, use a saved result and say so.
# off      = never use saved results.
EXTRACTION_CACHE_MODE=fallback

# Where the app keeps its runtime files (database, uploads, page images).
# Leave unset locally: the default is the var/ folder in the repo.
# DATA_DIR=

# Budget guard for the public link.
MAX_LIVE_EXTRACTIONS_PER_DAY=150
